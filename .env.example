# 로그인은 `uv run naver-blog-mcp login`으로 브라우저에서 직접 합니다.
# 세션은 playwright-state/auth.json에 저장되며 비밀번호는 저장하지 않습니다.

# 블로그 아이디 (선택): 글쓰기 URL과 카테고리 조회에 사용
NAVER_BLOG_ID=

# 비밀번호 (선택, 권장하지 않음): 설정하면 세션 만료 시 자동 로그인을 시도합니다.
# 네이버는 자동 입력에 CAPTCHA를 자주 띄우므로 비워 두는 것을 권장합니다.
NAVER_BLOG_PASSWORD=

# Playwright 설정
HEADLESS=true
SLOW_MO=0
# chrome으로 설정하면 설치된 Google Chrome을 사용 (비우면 번들 Chromium)
BROWSER_CHANNEL=

# 로깅 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
